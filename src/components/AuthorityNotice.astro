---
import { articleUrl, type WikiLocale } from '../lib/config';
import { t } from '../lib/i18n';

interface Props {
  locale: WikiLocale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<aside class="article-notice authority-notice" role="note">
  <span class="authority-notice-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24">
      <path
        d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"
      ></path>
      <path d="m9 12 2 2 4-4"></path>
    </svg>
  </span>
  <div class="authority-notice-copy">
    <strong>{strings.authoritativeArticle}</strong>
    <span>{strings.authoritativeArticleDetail}</span>
    <a href={articleUrl('authoritative-articles', locale)}>
      {strings.authoritativeArticleLearnMore}
    </a>
  </div>
</aside>
