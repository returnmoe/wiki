---
import type { CollectionEntry } from 'astro:content';
import { ARTICLE_KINDS, pageUrl, type WikiLocale } from '../lib/config';
import { kindLabels, t } from '../lib/i18n';
import { getSeoDescriptor } from '../lib/seo-manifest-astro';
import WikiLayout from '../layouts/WikiLayout.astro';

interface Props {
  locale: WikiLocale;
  categories: CollectionEntry<'categories'>[];
}

const { locale, categories } = Astro.props;
const strings = t(locale);
const seo = await getSeoDescriptor(pageUrl('search', locale));
---

<WikiLayout seo={seo}>
  <section class="special-page search-page">
    <header class="special-page-header">
      <h1>{strings.search}</h1>
      <p>{strings.searchIntro}</p>
    </header>
    <form
      class="search-interface search-interface-page"
      action={pageUrl('search', locale)}
      method="get"
      data-search-root
      data-empty-message={strings.noResults}
      data-unavailable-message={strings.searchUnavailable}
      data-result-singular={strings.resultSingular}
      data-result-plural={strings.resultPlural}
    >
      <label class="search-input-wrap search-input-large">
        <span class="sr-only">{strings.search}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-4-4"></path>
        </svg>
        <input
          type="search"
          name="q"
          autocomplete="off"
          placeholder={strings.searchPlaceholder}
          data-search-input
        />
      </label>
      <div class="search-filters">
        <label>
          <span class="sr-only">{strings.filterKind}</span>
          <select data-search-kind>
            <option value="">{strings.filterKind}</option>
            {ARTICLE_KINDS.map((kind) => <option value={kind}>{kindLabels[locale][kind]}</option>)}
          </select>
        </label>
        <label>
          <span class="sr-only">{strings.filterCategory}</span>
          <select data-search-category>
            <option value="">{strings.filterCategory}</option>
            {
              categories.map((category) => (
                <option value={category.data.id}>{category.data.title}</option>
              ))
            }
          </select>
        </label>
      </div>
      <div class="search-status" data-search-status aria-live="polite"></div>
      <div class="search-results" data-search-results></div>
    </form>
  </section>
  <script is:inline src="/scripts/search.js" defer></script>
</WikiLayout>
